{
  "name": "tarenx-tools-monorepo",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r run dev",
    "build": "pnpm -r run build && pnpm run sitemap",

    "lint": "pnpm -r run lint",

		"dev:hub": "pnpm --filter hub run dev",
    "build:hub": "pnpm --filter hub run build",
    "dev:symbolpicker": "pnpm --filter symbolpicker run dev",
    "build:symbolpicker": "pnpm --filter symbolpicker run build",
		"dev:svgplayground": "pnpm --filter svgplayground run dev",
    "build:svgplayground": "pnpm --filter svgplayground run build",
		"dev:jsonformatter": "pnpm --filter jsonformatter run dev",
    "build:jsonformatter": "pnpm --filter jsonformatter run build",

		"preview": "pnpm run build && node scripts/preview.mjs",
    "deploy": "pnpm run build && node scripts/deploy.mjs",
    "sitemap": "node scripts/sitemap.mjs"
  },
  "packageManager": "pnpm@10.26.2+sha512.0e308ff2005fc7410366f154f625f6631ab2b16b1d2e70238444dd6ae9d630a8482d92a451144debc492416896ed16f7b114a86ec68b8404b2443869e68ffda6",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-static-copy": "^4.1.0"
  }
}
